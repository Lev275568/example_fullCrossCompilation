---
Language:        Cpp
Standard: Latest
BasedOnStyle: WebKit

SpaceBeforeRangeBasedForLoopColon: false
NamespaceIndentation: Inner
SeparateDefinitionBlocks: Always
FixNamespaceComments: true

AllowShortEnumsOnASingleLine: false
BreakBeforeBraces: Custom
BreakInheritanceList: BeforeComma
BreakConstructorInitializers: BeforeComma
EmptyLineBeforeAccessModifier: LogicalBlock
BreakStringLiterals: false

AlignAfterOpenBracket: BlockIndent

AllowShortCompoundRequirementOnASingleLine: true
AllowShortFunctionsOnASingleLine: InlineOnly
AllowShortLambdasOnASingleLine: true
SpaceAfterTemplateKeyword: false
BreakTemplateDeclarations: Yes
BreakBeforeTemplateCloser: true

BreakBeforeBinaryOperators: NonAssignment

BreakAfterAttributes: Always
# workaround for break after atributes https://github.com/llvm/llvm-project/issues/117552#issuecomment-2499478968
Macros: # NOTE: clang-format version >= 17 required
  - BOOST_NOINLINE=[[maybe_unused]]
  - BOOST_FORCEINLINE=[[maybe_unused]]
  - BOOST_SYMBOL_EXPORT=[[maybe_unused]]
  - BOOST_SYMBOL_VISIBLE=[[maybe_unused]]

SpaceBeforeCpp11BracedList: false
Cpp11BracedListStyle: true

SortIncludes: CaseSensitive
IncludeBlocks: Regroup

# IncludeBlocks: Regroup

ColumnLimit: 104
ReflowComments: Never

BraceWrapping:
  AfterCaseLabel: false
  AfterClass: true
  AfterEnum: false
  AfterFunction: true
  AfterNamespace: false
  AfterStruct: true

  BeforeCatch: true
  BeforeElse: true
  BeforeLambdaBody: false
  IndentBraces: false
  SplitEmptyFunction: false
  SplitEmptyRecord: false
  SplitEmptyNamespace: false

RemoveEmptyLinesInUnwrappedLines: true
WrapNamespaceBodyWithEmptyLines: Always
AllowShortNamespacesOnASingleLine: false
---
